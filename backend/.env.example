# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/trading_platform

# Redis (optional - used for order book caching in production)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Email (SendGrid/SES/SMTP)
# If empty, emails are logged to console (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@tradingplatform.local

# External Market Data Feed (Phase 2)
# Set USE_BINANCE_FEED=true and re-run `npm run seed` to enable real Binance prices on BTCUSD/ETHUSD
# This is FREE and works in production. No API key needed for public data.
USE_BINANCE_FEED=false
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Finnhub — REAL-TIME forex/crypto/stocks (RECOMMENDED for India 🇮🇳)
# FREE tier with WebSocket support — Indian users allowed (no country block)
# Sign up free: https://finnhub.io/  → 5 min, no card needed
# This is the BEST option since OANDA is blocked for Indian residents
FINNHUB_API_KEY=

# OANDA Practice — FREE real-time forex streaming (BLOCKED for India)
# Sign up at https://www.oanda.com/demo-account/login (NRIs only)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# Twelve Data — alternative free forex feed (REST polling, 30s delay on free tier)
# Use as backup. Sign up: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# KYC document storage (local fs)
# In production, replace with S3 or equivalent
KYC_UPLOAD_DIR=./uploads/kyc

# Risk
DEFAULT_MARGIN_CALL_LEVEL=80
DEFAULT_STOP_OUT_LEVEL=50

# SMS (Twilio - optional, falls back to console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push notifications (FCM - optional)
FCM_SERVER_KEY=

# Payments (mock | razorpay | stripe)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
