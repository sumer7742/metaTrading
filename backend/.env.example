# =============================================================================
# Trading Platform Backend — environment template.
# Copy to `.env` for local dev. In production, inject these from your secrets
# manager (AWS Secrets Manager / HashiCorp Vault / Doppler). NEVER commit
# the populated `.env` file.
# =============================================================================

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins. Production MUST set this
# explicitly — leaving blank uses CLIENT_URL/ADMIN_URL localhost defaults.
CORS_ORIGINS=
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ─── Database ────────────────────────────────────────────────────────────────
# Production: Mongo Atlas M10+ with replica set + PITR.
MONGODB_URI=mongodb://localhost:27017/trading_platform
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 2FA on admin endpoints. Default behavior:
#   - Production (NODE_ENV=production): REQUIRED unless set to false
#   - Dev / staging: NOT required unless set to true
# Set explicitly to override the default for your environment.
# ADMIN_REQUIRE_2FA=true
KYC_REQUIRED=true

# Per-user rate limits on trading endpoints.
RATE_LIMIT_ORDERS_PER_MIN=60
RATE_LIMIT_CLOSE_ALL_PER_MIN=10

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_RATE=0.1
PROMETHEUS_ENABLED=false

# ─── Payments: Razorpay (India) / Stripe (international) ─────────────────────
# Get from https://dashboard.razorpay.com → Settings → API Keys
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── LP: OANDA ───────────────────────────────────────────────────────────────
# Demo: https://api-fxpractice.oanda.com
# Live: https://api-fxtrade.oanda.com
# NOTE: OANDA is blocked for Indian residents on retail accounts.
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_TIMEOUT_MS=5000

# ─── LP: Binance ─────────────────────────────────────────────────────────────
# Testnet: https://testnet.binance.vision
# Live: https://api.binance.com
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TIMEOUT_MS=5000
# Public data feed only (no auth needed, FREE)
USE_BINANCE_FEED=false
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ─── LP: Custom (in-house aggregator / FIX bridge) ───────────────────────────
CUSTOM_LP_BASE_URL=
CUSTOM_LP_API_KEY=

# ─── Price feeds ─────────────────────────────────────────────────────────────
# Finnhub — REAL-TIME forex/crypto/stocks. FREE tier with WebSocket support.
# Sign up: https://finnhub.io/ (no card, no country block)
FINNHUB_API_KEY=
# Twelve Data — alternative free forex feed (REST polling).
TWELVE_DATA_API_KEY=

# ─── Email (transactional) ───────────────────────────────────────────────────
# Production: SendGrid, Postmark, or AWS SES.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@tradingplatform.local

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
# Production: Twilio or MSG91 (India).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Push notifications (FCM) ────────────────────────────────────────────────
FCM_SERVER_KEY=

# ─── KYC document storage ────────────────────────────────────────────────────
# Local dir for dev. Production: S3 / GCS with presigned URLs.
KYC_UPLOAD_DIR=./uploads/kyc

# ─── Risk ────────────────────────────────────────────────────────────────────
DEFAULT_MARGIN_CALL_LEVEL=80
DEFAULT_STOP_OUT_LEVEL=50

# HYBRID risk-engine thresholds (per-order A/B routing).
HYBRID_LARGE_NOTIONAL_USD=50000
HYBRID_MAX_BBOOK_EXPOSURE=500000

# ─── Reconciliation (daily wallet-vs-trade cross-check) ──────────────────────
RECON_WINDOW_HOURS=24
RECON_TOLERANCE=0.01

# =============================================================================
# INDIAN STOCK MARKET — BROKER-AGNOSTIC TRADING TERMINAL
# =============================================================================
# Users trade through THEIR OWN broker accounts. We are not a broker: we route
# orders to the user's broker via adapters. Adding a broker never requires an
# env change beyond that broker's own optional overrides.
#
# Nothing in this section affects the forex / crypto engines.

# Master kill switch for every /api/broker and /api/orders route (404 when off).
BROKER_MODULE_ENABLED=true

# Pin outbound broker API calls to IPv4 (default true). Broker order APIs gate
# ORDER PLACEMENT to the static IP(s) you register in the broker dashboard.
# Home/office links usually egress over a ROTATING temporary IPv6 that won't
# match the registered IPv6, so orders get "Invalid IP" (Dhan DH-905) even
# though reads succeed. IPv4-first makes the broker see your registered IPv4.
# Set false only if you deliberately register + use a STATIC IPv6.
BROKER_FORCE_IPV4=true

# ─── Credential encryption (REQUIRED in production) ──────────────────────────
# Broker access tokens are stored AES-256-GCM encrypted. Without a key the
# module refuses to store credentials in production and uses an INSECURE
# derived dev key elsewhere.
#
#   Generate:  openssl rand -hex 32
BROKER_ENCRYPTION_KEY=
# Key rotation: "k1:<hex32>,k2:<hex32>". New writes use BROKER_ENCRYPTION_KEY_ID
# (or the last listed); old rows keep decrypting with the key they name, so no
# bulk re-encrypt is needed.
BROKER_ENCRYPTION_KEYS=
BROKER_ENCRYPTION_KEY_ID=
# AWS KMS instead of env keys (requires @aws-sdk/client-kms).
BROKER_KMS_KEY_ID=

# ─── Dhan (DhanHQ v2) ────────────────────────────────────────────────────────
# NOTE: no platform-wide Dhan token here. Each USER pastes their own token,
# generated at Dhan web → Profile → DhanHQ Trading APIs. The values below only
# tune transport behaviour.
# (DHAN_CLIENT_ID / DHAN_ACCESS_TOKEN elsewhere in this file belong to the
# existing market-data feed and are unrelated to per-user broker trading.)
DHAN_API_BASE=https://api.dhan.co/v2
DHAN_ORDER_WS_URL=wss://api-order-update.dhan.co
DHAN_ORDER_TIMEOUT_MS=8000
DHAN_DATA_TIMEOUT_MS=7000
DHAN_WS_HEARTBEAT_MS=25000
DHAN_WS_IDLE_MS=70000
DHAN_HISTORY_MAX_PAGES=20

# Dhan OAuth partner flow (MODE 2). Leave blank — the manual-token flow is
# used until these are set, at which point OAuth is offered automatically.
DHAN_OAUTH_CLIENT_ID=
DHAN_OAUTH_CLIENT_SECRET=
DHAN_OAUTH_REFRESH_ENABLED=false
BROKER_OAUTH_REDIRECT_URI=

# ─── Order queue + rate limiting (per broker) ────────────────────────────────
# Our limiter sits in front of EVERY broker call so the broker's published
# limits are never exceeded. Override per broker/category if a broker changes
# its quota: BROKER_RATELIMIT_<BROKER>_<CATEGORY>_<WINDOW>
#   e.g. BROKER_RATELIMIT_DHAN_ORDERS_PERSECOND=20
BROKER_QUEUE_DHAN_CONCURRENCY=4
BROKER_QUEUE_DHAN_MAX=1000

# Per-user HTTP limits on our own endpoints (separate from broker limits).
BROKER_RATE_LIMIT_ORDERS_PER_MIN=100
BROKER_RATE_LIMIT_READS_PER_MIN=300
BROKER_RATE_LIMIT_CONNECT_PER_15MIN=20

# ─── Adapter pool ────────────────────────────────────────────────────────────
BROKER_ADAPTER_TTL_MS=600000
BROKER_ADAPTER_MAX=2000
# Consecutive broker failures before a connection is flagged ERROR in the UI.
BROKER_FAILURE_THRESHOLD=10

# ─── Portfolio read cache (Redis when REDIS_URL is set, else in-memory) ──────
BROKER_CACHE_TTL_FUNDS_MS=5000
BROKER_CACHE_TTL_POSITIONS_MS=3000
BROKER_CACHE_TTL_HOLDINGS_MS=30000
BROKER_CACHE_TTL_ORDERS_MS=2000
BROKER_CACHE_TTL_QUOTES_MS=1000
BROKER_CACHE_TTL_INSTRUMENT_MS=600000

# ─── Order reconciliation (websocket primary, polling fallback) ──────────────
BROKER_SYNC_ENABLED=true
BROKER_SYNC_INTERVAL_MS=20000
BROKER_SYNC_BATCH=50
BROKER_SYNC_LOOKBACK_HOURS=12

# ─── Audit / logging ─────────────────────────────────────────────────────────
# Full request→queue→broker→exchange→response trail. Secrets are redacted
# before any write; tokens are never logged.
BROKER_LOG_PERSIST=true
BROKER_LOG_TTL_DAYS=30
BROKER_ERROR_TTL_DAYS=90
BROKER_ERROR_STACKS=false

# ─── Market data provider (execution and prices are decoupled) ───────────────
# AUTO | DHAN | TRUEDATA | GLOBALDATAFEEDS | POLYGON | FINNHUB
# Charts (TradingView Lightweight Charts) are NOT affected by this setting.
MARKET_DATA_PROVIDER=AUTO

# Order id prefix — clientOrderId format: PX-YYYYMMDD-XXXXXXXX
BROKER_ORDER_ID_PREFIX=PX
