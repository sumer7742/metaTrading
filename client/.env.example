VITE_API_URL=/api
VITE_WS_URL=ws://35.154.225.175/ws
# Public-facing origin used when generating shareable referral / reset
# links. If unset the FE falls back to window.location.origin (fine for
# dev; in production set this so links don't say "localhost").
VITE_PUBLIC_URL=https://trading.metawebdevelopment.cloud

# Production build — set via Docker --build-arg, not via this file:
#   docker build --build-arg VITE_API_URL=https://trading.metawebdevelopment.cloud/api \
#                --build-arg VITE_WS_URL=wss://trading.metawebdevelopment.cloud/ws \
#                --build-arg VITE_PUBLIC_URL=https://trading.metawebdevelopment.cloud \
#                -t tp-client .
