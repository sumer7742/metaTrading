# Local dev (npm run dev) — points at locally-running backend.
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:5000/ws

# Production build — set via Docker --build-arg, not via this file:
#   docker build --build-arg VITE_API_URL=https://api.zerovant.in/api \
#                --build-arg VITE_WS_URL=wss://api.zerovant.in/ws \
#                -t tp-client .
