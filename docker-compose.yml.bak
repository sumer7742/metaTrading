# Production-style compose for self-hosted EC2 deploy.
#
# Three containers:
#   backend  : Node API + WebSocket on internal port 5000
#   client   : nginx serving the user SPA bundle on internal port 80
#   admin    : nginx serving the admin SPA bundle on internal port 80
#
# Each container binds to 127.0.0.1:<host-port> ONLY — so only the host's
# nginx (TLS terminator) can reach them. No port is exposed to the
# internet directly; the EC2 security group only needs 80 + 443 + 22.
#
# Host nginx routes a single domain by path:
#   trading.metawebdevelopment.cloud/api/*    → 127.0.0.1:5000  (backend)
#   trading.metawebdevelopment.cloud/admin/*  → 127.0.0.1:8082  (admin SPA)
#   trading.metawebdevelopment.cloud/*        → 127.0.0.1:8081  (client SPA)
#
# Usage:
#   docker compose up -d --build
#   docker compose logs -f
#   docker compose down

services:
  backend:
    build:
      context: ./backend
    image: tp-backend:latest
    container_name: tp-backend
    restart: unless-stopped
    env_file:
      - ./backend/.env
    ports:
      - "127.0.0.1:5000:5000"
    volumes:
      # KYC document uploads persist across container restarts.
      - ./backend/uploads:/app/uploads
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:5000/api/health"]
      interval: 30s
      timeout: 5s
      start_period: 15s
      retries: 3

  client:
    build:
      context: ./client
      args:
        VITE_API_URL: https://trading.metawebdevelopment.cloud/api
        VITE_WS_URL: wss://trading.metawebdevelopment.cloud/ws
    image: tp-client:latest
    container_name: tp-client
    restart: unless-stopped
    ports:
      - "127.0.0.1:8081:80"
    depends_on:
      - backend

  admin:
    build:
      context: ./admin
      args:
        VITE_API_URL: https://trading.metawebdevelopment.cloud/api
        VITE_BASE: /admin/
    image: tp-admin:latest
    container_name: tp-admin
    restart: unless-stopped
    ports:
      - "127.0.0.1:8082:80"
    depends_on:
      - backend
