# =============================================================================
# Production env for self-hosted Docker deploy.
# Copy to .env.production (gitignored) and fill in every secret.
#
# DO NOT commit the populated file. Use a secrets manager when scaling.
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info

# Domains served by nginx — comma-separated allowlist.
CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
CLIENT_URL=https://app.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# Auth — generate each with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_64_hex_chars
JWT_REFRESH_SECRET=change_me_different_64_hex_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Production posture
ADMIN_REQUIRE_2FA=true
KYC_REQUIRED=true
RATE_LIMIT_ORDERS_PER_MIN=60
RATE_LIMIT_CLOSE_ALL_PER_MIN=10

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PROMETHEUS_ENABLED=true

# Razorpay (LIVE keys — from dashboard.razorpay.com → Settings → API Keys)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LP credentials (optional — only needed for A_BOOK / HYBRID routing)
OANDA_BASE_URL=https://api-fxtrade.oanda.com
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Price feeds (free tier — Finnhub recommended for forex in India)
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# Email (transactional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yourdomain.com

# SMS (MSG91 for India / Twilio international)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Risk thresholds (HYBRID mode)
HYBRID_LARGE_NOTIONAL_USD=50000
HYBRID_MAX_BBOOK_EXPOSURE=500000
